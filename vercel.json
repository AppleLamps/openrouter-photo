{
    "version": 2,
    "buildCommand": "",
    "outputDirectory": ".",
    "framework": null,
    "installCommand": "npm install",
    "routes": [
        {
            "src": "/favicon.ico",
            "dest": "/favicon.svg"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}