{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "version": 2,
    "fluid": true,
    "functions": {
        "api/generate.js": {
            "maxDuration": 120
        }
    },
    "routes": [
        {
            "src": "/api/generate",
            "dest": "/api/generate.js"
        },
        {
            "src": "/api/enhance",
            "dest": "/api/enhance.js"
        },
        {
            "src": "/api/random-prompt",
            "dest": "/api/random-prompt.js"
        },
        {
            "src": "/api/test-key",
            "dest": "/api/test-key.js"
        },
        {
            "src": "/api/test-xai-key",
            "dest": "/api/test-xai-key.js"
        },
        {
            "src": "/api/test-evolink-key",
            "dest": "/api/test-evolink-key.js"
        },
        {
            "src": "/api/generation-status",
            "dest": "/api/generation-status.js"
        },
        {
            "src": "/api/video-status",
            "dest": "/api/video-status.js"
        },
        {
            "src": "/api/image-proxy",
            "dest": "/api/image-proxy.js"
        },
        {
            "src": "/css/(.*)",
            "dest": "/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/js/$1"
        },
        {
            "src": "/shared/(.*)",
            "dest": "/shared/$1"
        },
        {
            "src": "/public/(.*)",
            "dest": "/public/$1"
        },
        {
            "src": "/sw.js",
            "dest": "/sw.js"
        },
        {
            "src": "/favicon.svg",
            "dest": "/favicon.svg"
        },
        {
            "src": "/favicon.ico",
            "dest": "/favicon.svg"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
