{
    "version": 2,
    "builds": [
        {
            "src": "api/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "*.html",
            "use": "@vercel/static"
        },
        {
            "src": "css/**",
            "use": "@vercel/static"
        },
        {
            "src": "js/**",
            "use": "@vercel/static"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        },
        {
            "src": "sw.js",
            "use": "@vercel/static"
        },
        {
            "src": "favicon.svg",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/generate",
            "dest": "/api/generate.js"
        },
        {
            "src": "/api/enhance",
            "dest": "/api/enhance.js"
        },
        {
            "src": "/api/random-prompt",
            "dest": "/api/random-prompt.js"
        },
        {
            "src": "/api/test-key",
            "dest": "/api/test-key.js"
        },
        {
            "src": "/api/video-status",
            "dest": "/api/video-status.js"
        },
        {
            "src": "/css/(.*)",
            "dest": "/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/js/$1"
        },
        {
            "src": "/public/(.*)",
            "dest": "/public/$1"
        },
        {
            "src": "/sw.js",
            "dest": "/sw.js"
        },
        {
            "src": "/favicon.svg",
            "dest": "/favicon.svg"
        },
        {
            "src": "/favicon.ico",
            "dest": "/favicon.svg"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}