# Server Configuration
# Port for local Express server (default: 3000)
PORT=3000

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Use '*' to allow all origins, or specify specific domains
# Example: https://example.com,https://app.example.com
ALLOWED_ORIGIN=*

# Optional: Fal API key (fallback only — users can also provide their own via the Settings panel)
# Required for Fal Seedream models (fal-ai/bytedance/seedream/*)
# Get one at https://fal.ai/dashboard/keys
# FAL_KEY=
