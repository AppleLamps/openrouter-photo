# Server Configuration
# Port for local Express server (default: 3000)
PORT=3000

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Leave blank to allow only same-origin browser requests.
# Use '*' only for intentionally public API deployments.
# Example: https://example.com,https://app.example.com
ALLOWED_ORIGIN=

# API abuse protection
# Set API_RATE_LIMIT_MAX=0 to disable the in-memory limiter.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=60

# Optional: OpenRouter API key (server fallback; browser can override via Settings)
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional: Evolink API key (fallback only — users can also provide their own via the Settings panel)
# Required for Evolink models (Seedream, Z Image Turbo, Seedance 2.0 video)
# Get one at https://evolink.ai/dashboard/keys
# EVOLINK_API_KEY=

# Optional: xAI API key (fallback only — users can also provide their own via the Settings panel)
# Required for Grok image and video models. Get one at https://console.x.ai
# XAI_API_KEY=
