# Server Configuration
# Port for local Express server (default: 3000)
PORT=3000

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Leave blank to allow only same-origin browser requests.
# Use '*' only for intentionally public API deployments.
# Example: https://example.com,https://app.example.com
ALLOWED_ORIGIN=

# API abuse protection
# Set API_RATE_LIMIT_MAX=0 to disable the in-memory limiter.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=60

# Optional: OpenRouter API key (server fallback; browser can override via Settings)
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional: Fal API key (fallback only — users can also provide their own via the Settings panel)
# Required for Fal Seedream models (fal-ai/bytedance/seedream/*)
# Get one at https://fal.ai/dashboard/keys
# FAL_KEY=
